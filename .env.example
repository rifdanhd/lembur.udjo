# Existing application database. Use a direct, non-pooled URL for Prisma migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require"

# Payload and admin access
PAYLOAD_SECRET="replace-with-a-long-random-secret"
CRM_SECRET="replace-with-a-long-random-secret"

# Phase 2: payment sandbox (never expose these to the browser)
TICKETING_SANDBOX_ENABLED="false"
TICKETING_SALES_APPROVED="false"
TICKETING_SECRET="replace-with-at-least-32-random-characters"
TICKETING_CRON_SECRET="replace-with-another-32-random-characters"
# Enable only when Nginx overwrites X-Real-IP with the trusted remote address.
TICKETING_TRUST_PROXY="false"
# Sandbox keys come in two formats: "SB-Mid-server-..." or the newer "Mid-server-...".
MIDTRANS_SERVER_KEY="Mid-server-..."
MIDTRANS_CLIENT_KEY="Mid-client-..."
MIDTRANS_IS_PRODUCTION="false"

# Phase 2: Auth.js
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Phase 2: email notifications
RESEND_API_KEY="re_..."
EMAIL_FROM="Lembur Udjo <noreply@example.com>"

# Booking origin: keep the old domain until DNS/TLS and new endpoints are verified.
BOOKING_PUBLIC_URL="https://ticket.lemburudjoparahyangan.com"
# Google OAuth Web Application; callback = BOOKING_PUBLIC_URL + /api/ticketing/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Enable only AFTER new HTTPS, OAuth and direct webhook verification. GET/HEAD only.
BOOKING_REDIRECT_VERIFIED="false"

# Optional outbound booking/payment/ticket mail uses existing RESEND_API_KEY + EMAIL_FROM.
# Authenticated worker: POST /api/ticketing/emails/dispatch with Bearer TICKETING_CRON_SECRET.
# Do not configure TICKETING_SANDBOX_NOTIFICATION_URL on a shared DB.
