generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  ADMIN
  STAFF
}

enum ProductType {
  ADULT
  CHILD
  GROUP
  PERFORMANCE_PACKAGE
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  REFUNDED
  PAYMENT_REVIEW
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  SETTLED
  FAILED
  EXPIRED
  REFUNDED
}

enum TicketStatus {
  ISSUED
  USED
  CANCELLED
}

model User {
  id          String      @id @default(cuid())
  name        String?
  email       String      @unique
  role        AdminRole   @default(STAFF)
  active      Boolean     @default(true)
  passwordHash String?
  sessions    StaffSession[]
  checkIns    CheckIn[]
  auditLogs   AuditLog[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model StaffSession {
  tokenHash String @id
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([userId])
  @@index([expiresAt])
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  imagePath   String?
  policy      String?
  categoryId  String?
  category    BookingCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  type        ProductType
  price       Int
  active      Boolean     @default(true)
  orderItems  OrderItem[]
  schedules   ProductSchedule[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([active, type])
  @@index([categoryId])
}

model BookingCategory {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String
  image       String
  active      Boolean @default(false)
  sortOrder   Int @default(0)
  products    Product[]
}

model Schedule {
  id          String      @id @default(cuid())
  date        DateTime    @db.Date
  session     String
  capacity    Int
  reserved    Int         @default(0)
  sold        Int         @default(0)
  active      Boolean     @default(true)
  orderItems  OrderItem[]
  products    ProductSchedule[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([date, session])
  @@index([date, active])
}

// No rows for a product preserves its legacy global schedule/base-price behavior.
// Once configured, only explicitly active product/schedule pairs can be sold.
model ProductSchedule {
  productId  String
  scheduleId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  price      Int
  active     Boolean @default(true)
  updatedAt  DateTime @updatedAt

  @@id([productId, scheduleId])
  @@index([scheduleId, active])
}

model Customer {
  id          String      @id @default(cuid())
  name        String
  email       String      @unique
  whatsapp    String?
  orders      Order[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Order {
  id          String       @id @default(cuid())
  orderNumber String       @unique
  customerId  String
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status      OrderStatus  @default(PENDING)
  totalAmount Int
  expiresAt   DateTime
  paidAt      DateTime?
  requestKeyHash String?    @unique
  requestHash    String?
  visitorId     String?
  visitor       VisitorAccount? @relation(fields: [visitorId], references: [id], onDelete: Restrict)
  items       OrderItem[]
  payments    Payment[]
  tickets     Ticket[]
  emails      EmailDelivery[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([customerId, createdAt])
  @@index([status, expiresAt])
  @@index([visitorId, createdAt])
}

model VisitorAccount {
  id           String @id @default(cuid())
  name         String
  email        String @unique
  passwordHash String?
  googleSubject String? @unique
  emailVerifiedAt DateTime?
  resets PasswordReset[]
  sessions     VisitorSession[]
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PasswordReset {
  tokenHash String @id
  visitorId String
  visitor VisitorAccount @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([visitorId])
  @@index([expiresAt])
}

model OAuthAttempt {
  stateHash String @id
  verifier String
  nonce String
  continueTo String
  expiresAt DateTime
  @@index([expiresAt])
}

model VisitorSession {
  id        String @id @default(cuid())
  tokenHash String @unique
  visitorId String
  visitor   VisitorAccount @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([visitorId])
}

model OrderItem {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  scheduleId  String
  schedule    Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  productName String
  unitPrice   Int
  quantity    Int
  lineTotal   Int
  tickets     Ticket[]
  createdAt   DateTime  @default(now())

  @@index([orderId])
  @@index([scheduleId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String
  providerPaymentId String?
  status            PaymentStatus @default(PENDING)
  amount            Int
  rawResponse       Json?
  paidAt            DateTime?
  checkoutUrl       String?
  checkoutStartedAt DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([provider, providerPaymentId])
  @@index([orderId, status])
}

model RateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model Ticket {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  code        String       @unique
  qrToken     String       @unique
  status      TicketStatus @default(ISSUED)
  issuedAt    DateTime     @default(now())
  usedAt      DateTime?
  checkIn     CheckIn?

  @@index([orderId, status])
}

model CheckIn {
  id          String   @id @default(cuid())
  ticketId    String   @unique
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  checkedById String?
  checkedBy   User?    @relation(fields: [checkedById], references: [id], onDelete: SetNull)
  checkedAt   DateTime @default(now())
  source      String?
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

// Optional outbound mail: committed with the event, delivered outside payment requests.
model EmailDelivery {
  id                String @id @default(cuid())
  eventKey          String @unique
  orderId           String
  order             Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  kind              String
  recipient         String
  subject           String
  text              String
  state             String @default("PENDING")
  attempts          Int @default(0)
  nextAttemptAt     DateTime @default(now())
  lockedUntil       DateTime?
  claimId           String?
  providerMessageId String?
  lastError         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([state, nextAttemptAt])
  @@index([orderId])
}
